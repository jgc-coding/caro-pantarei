---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Einer der zwei Wege auf der Startseite: Pantarei (still) oder Playfight (wild). */
interface Props {
  titel: string;
  unterzeile: string;
  text: string;
  ziel: string;
  linktext: string;
  bild: ImageMetadata;
  alt: string;
  welt: 'still' | 'wild';
  /**
   * Welcher Teil des Fotos sichtbar bleibt. Die Karte schneidet hochformatige Bilder
   * stark in der Hoehe — ohne Angabe landet der Schnitt in der Mitte und kappt Koepfe.
   */
  bildPosition?: string;
}

const {
  titel,
  unterzeile,
  text,
  ziel,
  linktext,
  bild,
  alt,
  welt,
  bildPosition = '50% 50%',
} = Astro.props;
---

<article class="wegkarte einblenden" data-welt={welt}>
  <Image
    class="wegkarte__bild"
    src={bild}
    alt={alt}
    widths={[400, 640, 860, 1200]}
    sizes="(max-width: 55rem) 92vw, 30rem"
    format="webp"
    quality={78}
    style={`object-position: ${bildPosition}`}
  />
  <div>
    <p class="marke-zeile">{unterzeile}</p>
    <h3 class="wegkarte__titel">{titel}</h3>
  </div>
  <p class="wegkarte__text">{text}</p>
  <div class="wegkarte__fuss">
    <a class="weiter" href={ziel}>{linktext} <span aria-hidden="true">→</span></a>
  </div>
</article>
