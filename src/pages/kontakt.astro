---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Abschnitt from '../components/Abschnitt.astro';
import Knopf from '../components/Knopf.astro';
import Platzhalter from '../components/Platzhalter.astro';
import Kontaktformular from '../components/Kontaktformular.astro';
import { marke, istOffen } from '../config/marke';

const kontaktzeilen = [
  { titel: 'E-Mail', wert: marke.kontakt.email },
  { titel: 'Telefon', wert: marke.kontakt.telefon },
];

const mailZiel = istOffen(marke.kontakt.email)
  ? marke.kontakt.email
  : `mailto:${marke.kontakt.email}`;
---

<Grundgeruest
  titel="Kontakt"
  beschreibung="Sitzung anfragen, Playfight-Termine erfragen oder Caroline für Festival, Event und Jugendgruppe buchen."
>
  <Abschnitt>
    <div class="schmal">
      <p class="marke-zeile">Kontakt</p>
      <h1>Schreib mir.</h1>
      <p class="vorlauf" style="margin-top: var(--raum-5)">
        Du möchtest eine Sitzung anfragen, hast eine Frage zum Playfight — oder Du möchtest
        mich für ein Festival, ein Event oder eine Jugendgruppe buchen? Dann melde Dich.
        Ich antworte, so schnell ich kann.
      </p>

      <div class="knopf-reihe">
        <Knopf ziel={mailZiel}>E-Mail schreiben</Knopf>
      </div>
    </div>
  </Abschnitt>

  <Abschnitt flaeche>
    <div class="schmal">
      <dl class="eckdaten">
        {
          kontaktzeilen.map((zeile) => (
            <div class="eckdaten__zeile">
              <dt class="eckdaten__titel">{zeile.titel}</dt>
              <dd class="eckdaten__wert">
                {istOffen(zeile.wert) ? <Platzhalter text={zeile.wert} /> : zeile.wert}
              </dd>
            </div>
          ))
        }
      </dl>

    </div>
  </Abschnitt>

  <Abschnitt eng>
    <div class="schmal">
      <p class="marke-zeile">Oder direkt hier</p>
      <h2 style="margin-bottom: var(--raum-5)">Schreib mir eine Nachricht</h2>
      <Kontaktformular />
    </div>
  </Abschnitt>
</Grundgeruest>
