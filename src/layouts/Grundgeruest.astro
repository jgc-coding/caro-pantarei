---
// Schriften selbst gehostet — niemals ueber ein CDN (DSGVO).
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/karla';
import '../styles/ci.css';
import '../styles/basis.css';

import Kopfzeile from '../components/Kopfzeile.astro';
import Fusszeile from '../components/Fusszeile.astro';
import { marke } from '../config/marke';

interface Props {
  titel: string;
  beschreibung: string;
  /** Faerbt die Seite: "still" = Pantarei (Lavendel), "wild" = Playfight (Ton). */
  welt?: 'still' | 'wild';
}

const { titel, beschreibung, welt = 'still' } = Astro.props;
const seitentitel = `${titel} — ${marke.name}`;
const kanonisch = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de" data-menue="zu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

    <!--
      Laeuft vor dem ersten Zeichnen. Setzt zwei Schalter:
      - data-js  : es gibt JavaScript, das eingeklappte Menue darf existieren
      - data-animiert : Bewegung ist erwuenscht, Elemente duerfen erst unsichtbar sein
      Ohne dieses Skript bleibt alles sichtbar und bedienbar.
    -->
    <script is:inline>
      document.documentElement.dataset.js = 'ja';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.animiert = 'ja';
      }
    </script>
  </head>

  <body data-welt={welt}>
    <a class="sprungmarke" href="#inhalt">Zum Inhalt springen</a>
    <Kopfzeile />
    <main id="inhalt">
      <slot />
    </main>
    <Fusszeile />

    <script>
      // Einblenden beim Hereinscrollen. Laeuft nur, wenn Bewegung erwuenscht ist.
      if (document.documentElement.dataset.animiert === 'ja') {
        const ziele = document.querySelectorAll<HTMLElement>('.zeilenleiter, .einblenden');
        const beobachter = new IntersectionObserver(
          (eintraege) => {
            for (const eintrag of eintraege) {
              if (!eintrag.isIntersecting) continue;
              eintrag.target.classList.add('ist-sichtbar');
              beobachter.unobserve(eintrag.target);
            }
          },
          // threshold 0: jede noch so kleine Beruehrung loest aus. Mit einem hoeheren
          // Wert koennte ein sehr hohes Element die Schwelle nie erreichen und bliebe
          // dauerhaft unsichtbar — ein stiller Ausfall, den niemand bemerkt.
          { rootMargin: '0px 0px -12% 0px', threshold: 0 },
        );
        ziele.forEach((ziel) => beobachter.observe(ziel));
      }

      // Menue auf schmalen Bildschirmen auf- und zuklappen.
      const knopf = document.querySelector<HTMLButtonElement>('[data-menue-knopf]');
      const wurzel = document.documentElement;

      function menueSetzen(offen: boolean) {
        wurzel.dataset.menue = offen ? 'offen' : 'zu';
        knopf?.setAttribute('aria-expanded', String(offen));
      }

      knopf?.addEventListener('click', () => {
        menueSetzen(wurzel.dataset.menue !== 'offen');
      });

      document.addEventListener('keydown', (ereignis) => {
        if (ereignis.key === 'Escape' && wurzel.dataset.menue === 'offen') {
          menueSetzen(false);
          knopf?.focus();
        }
      });
    </script>
  </body>
</html>
